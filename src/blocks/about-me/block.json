{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ft-blocks/about-me",
	"version": "0.1.0",
	"category": "design",
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "full", "wide" ]
	},
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"content": {
			"type": "string",
			"default": ""
		},
		"button": {
			"type": "string",
			"default": ""
		},
		"images": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "number",
						"default": null
					},
					"url": {
						"type": "string",
						"default": ""
					}
				},
				"default": {
					"id": 0,
					"url": ""
				}
			}
		},
		"backgroundImage": {
			"type": "object",
			"properties": {
				"id": {
					"type": "number",
					"default": null
				},
				"url": {
					"type": "string",
					"default": ""
				}
			},
			"default": {
				"id": 0,
				"url": ""
			}
		}
	},
	"textdomain": "ft-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view-script.js",
	"render": "file:./render.php"
}

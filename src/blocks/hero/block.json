{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ft-blocks/hero",
	"version": "0.1.3",
	"category": "ft-blocks",
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "full", "wide" ]
	},
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"decorText": {
			"type": "string",
			"default": ""
		},
		"images": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"type": "object",
					"properties": {
						"id": {
							"type": "integer",
							"default": null
						},
						"url": {
							"type": "string",
							"default": ""
						}
					},
					"default": {
						"id": null,
						"url": ""
					}
				}
			}
		},
		"button": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "ft-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view-script.js",
	"render": "file:./render.php"
}

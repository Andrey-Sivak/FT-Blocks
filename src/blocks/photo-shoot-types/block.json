{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ft-blocks/photo-shoot-types",
	"version": "0.1.0",
	"category": "ft-blocks",
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "full", "wide" ]
	},
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"activeTab": {
			"type": "number",
			"default": 0
		},
		"tabs": {
			"type": "array",
			"default": [
				{
					"tabLabel": "Tab 1",
					"title": "",
					"text": "",
					"button": "",
					"image": {
						"id": null,
						"url": ""
					}
				},
				{
					"tabLabel": "Tab 2",
					"title": "",
					"text": "",
					"button": "",
					"image": {
						"id": null,
						"url": ""
					}
				},
				{
					"tabLabel": "Tab 3",
					"title": "",
					"text": "",
					"button": "",
					"image": {
						"id": null,
						"url": ""
					}
				}
			],
			"items": {
				"type": "object",
				"properties": {
					"tabLabel": {
						"type": "string",
						"default": ""
					},
					"title": {
						"type": "string",
						"default": ""
					},
					"text": {
						"type": "string",
						"default": ""
					},
					"button": {
						"type": "string",
						"default": ""
					},
					"image": {
						"type": "object",
						"default": {
							"id": null,
							"url": ""
						}
					}
				}
			}
		}
	},
	"textdomain": "ft-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view-script.js",
	"render": "file:./render.php"
}

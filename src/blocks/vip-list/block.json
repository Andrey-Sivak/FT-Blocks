{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ft-blocks/vip-list",
	"version": "0.1.1",
	"category": "ft-blocks",
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "full", "wide" ]
	},
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"leftText": {
			"type": "string",
			"default": ""
		},
		"rightHeading": {
			"type": "string",
			"default": ""
		},
		"rightText": {
			"type": "string",
			"default": ""
		},
		"button": {
			"type": "string",
			"default": ""
		},
		"button2": {
			"type": "string",
			"default": ""
		},
		"features": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"title": {
						"type": "string",
						"default": ""
					},
					"text": {
						"type": "string",
						"default": ""
					}
				}
			}
		}
	},
	"textdomain": "ft-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ft-blocks/cta-banner",
	"version": "0.1.0",
	"category": "ft-blocks",
	"supports": {
		"anchor": true,
		"html": false,
		"align": [ "full", "wide" ]
	},
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"buttons": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"text": {
						"type": "string",
						"default": ""
					},
					"url": {
						"type": "string",
						"default": ""
					}
				}
			},
			"default": []
		},
		"backgroundImage": {
			"type": "object",
			"properties": {
				"id": {
					"type": "number",
					"default": null
				},
				"url": {
					"type": "string",
					"default": ""
				}
			},
			"default": {
				"id": null,
				"url": ""
			}
		}
	},
	"textdomain": "ft-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
